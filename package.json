{
  "name": "regwatch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "RegWatch (Showcase) - Multi-agent regulatory compliance copilot querying a cross-referenced **DORA × EU AI Act** corpus.",
  "author": {
    "name": "Antoine Delamare",
    "email": "antoine@blockchain-cie.com",
    "url": "https://www.linkedin.com/in/adelamare/"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "qdrant": "docker compose up -d qdrant",
    "ingest": "uv run --directory agent python -m rag.ingest",
    "ingest:verify": "uv run --directory agent python -m rag.ingest --verify",
    "ingest:dry-run": "uv run --directory agent python -m rag.ingest --dry-run",
    "mcp": "uv run --directory agent python -m mcp_server",
    "mcp:stdio": "uv run --directory agent python -m mcp_server --stdio",
    "graph": "uv run --directory agent python -m graph",
    "test:agent": "uv run --directory agent pytest",
    "test:agent:integration": "uv run --directory agent pytest -m integration"
  },
  "dependencies": {
    "@copilotkit/react-core": "^1.70.1",
    "@copilotkit/react-ui": "^1.70.1",
    "@copilotkit/runtime": "^1.70.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
