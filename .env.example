# RegWatch — environment variables.
# Copy to `.env` at the repository root. Never commit secrets.

# --- Embeddings ------------------------------------------------------------
# `fastembed` = local model, offline, reproducible (default).
# `mistral`   = EU-hosted cloud API; requires MISTRAL_API_KEY and network access.
EMBEDDING_PROVIDER=fastembed

# Multilingual models available in fastembed 0.8.0:
#   sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2   384 dim, 0.22 GB  (default)
#   sentence-transformers/paraphrase-multilingual-mpnet-base-v2   768 dim, 1.00 GB
#   intfloat/multilingual-e5-large                               1024 dim, 2.24 GB
# With EMBEDDING_PROVIDER=mistral, use `mistral-embed` (1024 dim).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Required only when EMBEDDING_PROVIDER=mistral.
# MISTRAL_API_KEY=

# --- Qdrant ----------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=regwatch

# --- Retrieval -------------------------------------------------------------
TOP_K=8
# Below this score no chunk is considered grounded enough to answer from.
SCORE_THRESHOLD=0.5

# --- MCP tool server -------------------------------------------------------
# Bind address and port of the Streamable HTTP transport. Use 0.0.0.0 when the
# server runs inside a container and has to be reachable from other services.
MCP_HOST=127.0.0.1
MCP_PORT=8300

# --- Couche 3 : orchestration ---
# Modèle de génération. mistral-small-2603 est Mistral Small 4 (MoE 119B,
# 6,5 Md actifs) — voir la note de coût dans les notes d'implémentation.
LLM_MODEL=mistral-small-2603
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60
